{
  "manifest_version": 3,
  "name": "Tag Master",
  "version": "1.1.0",
  "description": "Save pages, discover shared topics, and keep your tabs within reach.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "action": { "default_title": "Open Tag Master", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png" } },
  "options_page": "library.html",
  "commands": {
    "save-page": { "suggested_key": { "default": "Ctrl+Shift+P" }, "description": "Save the current page to Tag Master" }
  },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["capture.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
